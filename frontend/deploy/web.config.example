<?xml version="1.0" encoding="utf-8"?>
<!--
  EXAMPLE, not tested in this repository's CI. IIS serving the built frontend (frontend/dist): copy the contents of dist and this
  file (renamed to web.config) into the site folder. Needs the URL Rewrite module.
  It does the two things the application needs from a web server: every address that is not a file answers index.html (the
  application has its own routes), and the security headers (the API sets its own, but only for its own answers).
  Build the frontend with the address of the API:   VITE_API_BASE_URL=https://api.firma.ba npm run build
  Start with Content-Security-Policy-Report-Only, watch the browser console until nothing is reported, then rename the header.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Single page application" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=15552000" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.firma.ba; font-src 'self' data:; connect-src 'self' https://api.firma.ba wss://api.firma.ba; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Only the files with a hash in the name (the assets folder) are kept for a year; index.html must always be fetched again. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
