{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Path": "logs/ticketsystem-.log",
      "RetainedFiles": 30,
      "MaxFileSizeMb": 100
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "TicketSystemTech",
    "Audience": "TicketSystemTech.Client",
    "AccessTokenMinutes": 30
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Ticket System Tech",
    "ReplyTo": "",
    "TimeoutSeconds": 20
  },
  "Email": {
    "Outbox": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 20,
      "LeaseSeconds": 120,
      "KeepSentDays": 7,
      "KeepFailedDays": 30
    }
  },
  "GoogleAi": {
    "ApiKey": ""
  },
  "MicrosoftGraph": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "TemporaryPassword": {
    "ValidityMinutes": 10
  },
  "Sla": {
    "Mode": "CalendarHours",
    "TimeZoneId": "Europe/Sarajevo",
    "WorkdayStart": "08:00",
    "WorkdayEnd": "16:00"
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": "",
    "CertificateThumbprint": "",
    "CertificateStoreLocation": "CurrentUser",
    "AllowUnprotectedKeys": false
  },
  "Pii": {
    "HashKey": ""
  },
  "SeedAdmin": {
    "Email": "",
    "Password": "",
    "PrintGeneratedPassword": false
  }
}
