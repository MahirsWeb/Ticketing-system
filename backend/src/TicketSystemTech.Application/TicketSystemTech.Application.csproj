<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TicketSystemTech.Domain\TicketSystemTech.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <!-- NPOI/DataProtection pull these in transitively at versions with known advisories; pinned to patched releases. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NPOI's OOXML (.xlsx) support bundles the Apache POI OSMF (OOXML Schema) definitions; this just acknowledges their license. -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

</Project>
