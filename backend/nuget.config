<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A per-user NuGet.Config that defines "nuget.org" twice made the v2 feed win. That feed carries no
       vulnerability data, so the package vulnerability audit silently reported nothing.
       clear plus one explicit v3 source makes the audit result reproducible on every machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
